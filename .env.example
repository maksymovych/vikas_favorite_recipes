# Copy this file to .env.local and fill in the values (see README → Environment variables).
# .env.local is git-ignored — never commit real secrets.

# Neon Postgres connection string (saves contact form messages)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Vercel Blob read-write token (photo uploads on the contact form)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx
