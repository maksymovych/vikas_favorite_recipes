# Copy this file to .env.local and fill in the values (see README → Environment variables).
# .env.local is git-ignored — never commit real secrets.

# Neon Postgres connection string (saves contact form messages)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Vercel Blob read-write token (photo uploads on the contact form)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# Password for the private inbox at /admin (choose your own)
ADMIN_PASSWORD=choose-a-long-password

# Optional: email alerts for new messages (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
NOTIFY_EMAIL=you@example.com
